generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contribution {
  id        String   @id @default(cuid())
  name      String
  handle    String?
  zone      String
  amount    Int
  txId      String?  @unique
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())

  @@index([zone])
  @@index([amount])
  @@index([createdAt])
}
