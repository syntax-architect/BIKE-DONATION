generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contribution {
  id                String   @id @default(cuid())
  name              String
  partnerName       String?
  handle            String?
  linkUrl           String?
  city              String?
  mode              String   @default("SOLO")
  zone              String
  amount            Int
  txId              String?  @unique
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  isFounder         Boolean  @default(false)
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())

  @@index([zone])
  @@index([amount])
  @@index([city])
  @@index([status])
  @@index([createdAt])
}

model WrapVote {
  id        String   @id @default(cuid())
  option    String
  weight    Int      @default(1)
  createdAt DateTime @default(now())

  @@index([option])
}
